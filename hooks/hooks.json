{
  "description": "shuozhongwen: check written files and replies for invisible characters and garbled text (never modifies them); report at the end of the reply with the AI-likeness score.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.js"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run_display.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
